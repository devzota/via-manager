# ZTTeam VIA Management System - Environment Variables
# Khoa Master Key de ma hoa/giai ma toan bo du lieu nhay cam (AES-256-GCM - 64 ky tu hex)
ZTTEAM_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Port cho API server va WebSocket
ZTTEAM_PORT=5000

# So luong trinh duyet toi da chay dong thoi (Concurrency)
ZTTEAM_MAX_CONCURRENCY=3

# Thoi gian timeout cho trinh duyet (ms)
ZTTEAM_NAV_TIMEOUT=30000
